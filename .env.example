# ---------------------------------------------------------------------------
# Environment configuration for the Meeting Follow-Through Agent
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# NO SECRETS ARE COMMITTED TO THIS REPO. The `.env` file (with your real
# credentials) is git-ignored. The agent reads everything from environment
# variables at runtime.
#
# The Strands Agents SDK uses Amazon Bedrock (Claude Sonnet 4) by default.
# Provide AWS credentials in ANY standard way, for example:
#   - the AWS_ variables below, OR
#   - `aws configure` (shared credentials file), OR
#   - an IAM role (when running on EC2/ECS/Lambda), OR
#   - a Bedrock API key via AWS_BEARER_TOKEN_BEDROCK.
# ---------------------------------------------------------------------------

# --- Option 1: static AWS credentials ---
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token   # only if using temporary credentials

# --- AWS region that has Bedrock + Claude Sonnet 4 access enabled ---
AWS_REGION=us-west-2

# --- Option 2: Bedrock API key (alternative to the keys above) ---
# AWS_BEARER_TOKEN_BEDROCK=your-bedrock-api-key

# --- Optional: override the model id used by the agent ---
# Defaults to us.anthropic.claude-sonnet-4-5-20250929-v1:0 if unset.
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
